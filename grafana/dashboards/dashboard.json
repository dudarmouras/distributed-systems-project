            }
          },
          "description": "Envia o novo intervalo N de coleta para todos os probes via MQTT (topico probes/control). Erros de validacao ou de comunicacao com o servidor sao exibidos inline, sem usar alert() do navegador.",
          "id": 2,
          "links": [],
          "title": "Aumentar intervalo",
          "vizConfig": {
            "group": "text",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                },
                "content": "<div id=\"intervalControlWidget\" style=\"display:flex;flex-direction:column;gap:10px;margin-top:15px;font-family:sans-serif;\">\n  <div style=\"display:flex;align-items:center;gap:12px;\">\n    <input type=\"number\" id=\"probeInterval\" value=\"5000\" step=\"1000\" min=\"1000\" style=\"width:120px;padding:10px;border-radius:8px;border:1px solid #555;background:#2B2B2B;color:white;font-size:15px;\">\n    <span style=\"color:#ccc;\">ms</span>\n    <button id=\"applyIntervalBtn\" style=\"padding:11px 22px;border:none;border-radius:8px;background:linear-gradient(135deg,#5794F2,#3274D9);color:white;font-weight:bold;font-size:14px;cursor:pointer;transition:.2s;box-shadow:0 4px 10px rgba(87,148,242,.35);\">Aplicar Intervalo</button>\n  </div>\n  <div id=\"intervalFeedback\" style=\"display:none;padding:9px 14px;border-radius:6px;font-size:13px;font-weight:600;\"></div>\n</div>\n<script>\n(function(){\n  var btn=document.getElementById('applyIntervalBtn');\n  var input=document.getElementById('probeInterval');\n  var feedback=document.getElementById('intervalFeedback');\n  function showFeedback(msg, ok){\n    feedback.style.display='block';\n    feedback.style.background= ok ? 'rgba(87,166,87,0.18)' : 'rgba(214,73,73,0.18)';\n    feedback.style.color= ok ? '#7CD992' : '#FF8A8A';\n    feedback.style.border='1px solid ' + (ok ? '#3C8C4A' : '#A33A3A');\n    feedback.textContent= (ok ? '✔ ' : '⚠ ') + msg;\n  }\n  btn.addEventListener('mouseover', function(){ btn.style.filter='brightness(1.1)'; btn.style.transform='translateY(-2px)'; });\n  btn.addEventListener('mouseout', function(){ btn.style.filter='brightness(1)'; btn.style.transform='translateY(0)'; });\n  btn.addEventListener('click', function(){\n    var raw = input.value;\n    var val = parseInt(raw, 10);\n    if (!raw || isNaN(val) || val < 1000) {\n      showFeedback('Informe um intervalo numérico válido (mínimo 1000ms).', false);\n      return;\n    }\n    btn.disabled = true;\n    btn.textContent = 'Enviando...';\n    fetch('http://localhost:3000/api/control/interval', {\n      method: 'POST',\n      headers: {'Content-Type': 'application/json'},\n      body: JSON.stringify({ intervalo: val })\n    })\n    .then(function(res){\n      return res.json().then(function(data){ return { ok: res.ok, data: data }; }).catch(function(){ return { ok: res.ok, data: {} }; });\n    })\n    .then(function(result){\n      if (result.ok) {\n        showFeedback(result.data.message || 'Intervalo atualizado com sucesso.', true);\n      } else {\n        showFeedback(result.data.error || 'O servidor rejeitou o comando.', false);\n      }\n    })\n    .catch(function(){\n      showFeedback('Falha de comunicação com o servidor (verifique se o coletor está rodando em :3000).', false);\n    })\n    .finally(function(){\n      btn.disabled = false;\n      btn.textContent = 'Aplicar Intervalo';\n    });\n  });\n})();\n</script>",
                "mode": "html"
              }
            },
            "version": "13.1.0"
          }
        }
